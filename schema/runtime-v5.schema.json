{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dungeon-rules/v5",
  "title": "Dungeon rules runtime JSON v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "settings",
    "doorTypes",
    "types",
    "modules",
    "connections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modulesAfterStart",
        "startTypeId"
      ],
      "properties": {
        "modulesAfterStart": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Number of non-start modules; the final map contains one additional start module"
        },
        "startTypeId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "doorTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doorType"
      },
      "description": "Door opening sizes. Each size appears once (sizes differ by more than 20 mm); ports join only when their door types are the same"
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/moduleType"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "moduleType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "percent",
        "requiredMin"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "requiredMin": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minX",
        "maxX",
        "minY",
        "maxY",
        "minZ",
        "maxZ"
      ],
      "properties": {
        "minX": {
          "type": "integer"
        },
        "maxX": {
          "type": "integer"
        },
        "minZ": {
          "type": "integer"
        },
        "maxZ": {
          "type": "integer"
        },
        "minY": {
          "type": "integer"
        },
        "maxY": {
          "type": "integer"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "edge",
        "doorTypeId",
        "x",
        "y",
        "z",
        "allowedTypeIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "edge": {
          "enum": [
            "N",
            "E",
            "S",
            "W"
          ]
        },
        "doorTypeId": {
          "$ref": "#/$defs/id",
          "description": "A doorTypes id; also gives the opening width and height"
        },
        "x": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        },
        "allowedTypeIds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          ],
          "description": "null permits any related type; an array restricts target types"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "typeId",
        "bounds",
        "ports"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "typeId": {
          "$ref": "#/$defs/id"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "weight"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "doorType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Millimetres, along the side face"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Millimetres"
        }
      }
    }
  }
}
